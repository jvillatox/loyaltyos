---
export interface Props {
  title: string;
  body: string;
  iconName: string;
  pill?: boolean;
}

const { title, body, iconName, pill } = Astro.props;
---

<div class="feature-card group">
  <div class="feature-card__header">
    <span class="feature-card__icon" set:html={iconName} />
    {pill && (
      <span class="feature-card__pill">differentiator</span>
    )}
  </div>
  <h3 class="feature-card__title">{title}</h3>
  <p class="feature-card__body">{body}</p>
</div>

<style>
  .feature-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--card-pad-mobile);
    display: flex;
    flex-direction: column;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  @media (min-width: 768px) {
    .feature-card {
      padding: var(--card-pad-desk);
    }
  }
  .feature-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }
    .feature-card:hover {
      transform: none;
    }
  }

  .feature-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .feature-card__icon {
    width: 20px;
    height: 20px;
    color: var(--accent);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .feature-card__icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .feature-card__pill {
    background: var(--bg-base);
    border: 1px solid var(--accent);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .feature-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 8px 0 0;
  }

  .feature-card__body {
    font-size: 1rem;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 8px 0 0;
  }
</style>
