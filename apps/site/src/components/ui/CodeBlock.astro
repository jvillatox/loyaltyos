---
export interface Props {
  code: string;
  language?: string;
  variant?: "hero" | "inline";
  showTerminalDots?: boolean;
  showCopy?: boolean;
  class?: string;
}

const {
  code,
  language = "bash",
  variant = "inline",
  showTerminalDots = true,
  showCopy = true,
  class: className,
} = Astro.props;

const blockId = `code-${Math.random().toString(36).slice(2, 8)}`;

// Apply syntax highlighting: comments get special treatment
const highlightedLines = code
  .trim()
  .split("\n")
  .map((line) => {
    if (/^\s*[#]/.test(line) || /^\s*\/\//.test(line)) {
      return `<span class="code-comment">${line}</span>`;
    }
    return line;
  })
  .join("\n");
---

<figure class={`code-block code-block--${variant} not-prose ${className ?? ""}`.trim()}>
  {(showTerminalDots || showCopy || language) && (
    <div class="code-block__header">
      <div class="flex items-center gap-4">
        {showTerminalDots && (
          <div class="code-block__dots" aria-hidden="true">
            <span class="code-block__dot--red"></span>
            <span class="code-block__dot--yellow"></span>
            <span class="code-block__dot--green"></span>
          </div>
        )}
        {language && (
          <span class="font-mono text-[0.8125rem] text-[var(--text-muted)]"
            >{language}</span
          >
        )}
      </div>
      {showCopy && (
        <button
          type="button"
          class="code-block__copy"
          id={`${blockId}-copy`}
          data-code={code.trim()}
          aria-label="Copy code to clipboard"
        >
          Copy
        </button>
      )}
    </div>
  )}
  <pre class="code-block__pre" tabindex="0"><code class={`language-${language}`} set:html={highlightedLines} /></pre>
</figure>

<style>
  .code-block {
    background: var(--code-bg);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .code-block--hero {
    border-radius: var(--radius-xl);
  }
  .code-block--inline {
    border-radius: var(--radius-md);
  }

  .code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    padding: 0 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .code-block__dots {
    display: flex;
    gap: 6px;
  }

  .code-block__dot--red {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ef4444;
  }
  .code-block__dot--yellow {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f59e0b;
  }
  .code-block__dot--green {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
  }

  .code-block__copy {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--text-muted);
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    position: relative;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .code-block__copy::after {
    content: "";
    position: absolute;
    inset: -11px -8px;
  }
  .code-block__copy:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .code-block__copy.copied {
    color: var(--success);
    border-color: var(--success);
  }

  .code-block__pre {
    padding: 20px 24px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--code-text);
    white-space: pre;
  }

  .code-block :global(.code-comment) {
    color: var(--code-comment);
  }
</style>

<script>
  function setupCopyButtons() {
    document.querySelectorAll(".code-block__copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code") || "";
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = "Copied ✓";
          btn.setAttribute("aria-label", "Copied to clipboard");
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.setAttribute("aria-label", "Copy code to clipboard");
            btn.classList.remove("copied");
          }, 1500);
        } catch {
          // clipboard API not available — silently fail
        }
      });
    });
  }
  setupCopyButtons();
  document.addEventListener("astro:after-swap", setupCopyButtons);
</script>
