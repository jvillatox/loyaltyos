---
import EyebrowLabel from "../ui/EyebrowLabel.astro";
import Button from "../ui/Button.astro";
---

<section class="section" id="community">
  <div class="community__inner">
    <EyebrowLabel>Community</EyebrowLabel>
    <h2 class="section-title community__h2">
      Built in the open. Built with operators.
    </h2>
    <p class="community__body">
      Issues, PRs, and discussion shape every release. Star the repo to track
      every ship.
    </p>
    <div class="community__ctas">
      <Button
        variant="primary"
        href="https://github.com/jvillatox/loyaltyos"
        isExternal
      >
        ★ Star on GitHub
      </Button>
      <Button variant="secondary" href="https://jvillatox.github.io/loyaltyos/">
        Read the docs ↗
      </Button>
      <Button
        variant="secondary"
        href="https://github.com/jvillatox/loyaltyos/discussions"
        isExternal
      >
        Join discussions ↗
      </Button>
    </div>
  </div>
</section>

<style>
  .community__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .community__h2 {
    margin-top: var(--space-4);
    max-width: 792px;
  }

  .community__body {
    font-size: 1rem;
    color: var(--text-muted);
    margin: var(--space-4) 0 var(--space-10);
    max-width: 588px;
  }

  .community__ctas {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (max-width: 767px) {
    .community__ctas {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
