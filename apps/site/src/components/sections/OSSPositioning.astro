---
import EyebrowLabel from "../ui/EyebrowLabel.astro";
import Button from "../ui/Button.astro";
---

<section class="section" id="pricing">
  <div class="oss__inner">
    <EyebrowLabel>Pricing</EyebrowLabel>
    <h2 class="section-title oss__h2">MIT licensed. No strings.</h2>

    <div class="oss__columns">
      <div class="oss__col">
        <p class="oss__price">$0</p>
        <p class="oss__period">forever</p>
        <p class="oss__desc">
          MIT license. All features included. Helm chart and Docker images
          provided. Upgrade on your schedule.
        </p>
        <Button variant="secondary" href="#quick-start">Get started →</Button>
      </div>

      <div class="oss__col">
        <p class="oss__price">$0</p>
        <p class="oss__period">forever</p>
        <p class="oss__desc">
          Run it on AWS, GCP, Azure, Hetzner, Fly, or your laptop. We don't
          care where, and we don't phone home.
        </p>
        <Button variant="secondary" href="https://jvillatox.github.io/loyaltyos/">
          Read the deployment guide →
        </Button>
      </div>

      <div class="oss__col">
        <p class="oss__price oss__price--coming">Coming soon</p>
        <p class="oss__period">&nbsp;</p>
        <p class="oss__desc">
          Don't want to self-host? A managed offering is in the works. Join the
          waitlist to hear when it ships.
        </p>
        <Button variant="secondary" href="mailto:hello@loyalty-os.com">
          Join the waitlist →
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .oss__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .oss__h2 {
    margin-top: var(--space-4);
  }

  .oss__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    width: 100%;
    max-width: var(--max-width);
    margin-top: var(--space-12);
  }
  @media (min-width: 768px) {
    .oss__columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .oss__col {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .oss__col :global(a) {
    margin-top: auto;
  }

  .oss__price {
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.1;
  }

  .oss__price--coming {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-muted);
    font-style: italic;
  }

  .oss__period {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: var(--space-1) 0 var(--space-4);
  }

  .oss__desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 var(--space-6);
  }
</style>
