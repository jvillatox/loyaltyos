---
import EyebrowLabel from "../ui/EyebrowLabel.astro";
import Chip from "../ui/Chip.astro";

const stackChips = [
  "Node.js 20", "Fastify", "React 18", "Vite", "Lit", "Prisma",
  "PostgreSQL 15", "Redis 7", "BullMQ", "Lucia Auth", "Turborepo",
  "Helm", "OpenTelemetry", "Docker", "MCP SDK", "OpenRouter",
];

const monorepoTree = `loyaltyos/
├─ apps/
│  ├─ api/         Fastify REST API
│  ├─ admin/       React + Vite admin UI (with AI companion)
│  ├─ widget/      Lit Web Component
│  └─ mcp-server/  Model Context Protocol server (stdio + SSE)
└─ packages/
   ├─ core/        Points ledger, idempotency
   ├─ campaigns/   Rules engine, scheduling
   ├─ segments/    Customer targeting
   ├─ coupons/     Code generation & redemption
   ├─ rewards/     Catalog + fulfillment hooks
   ├─ badges/      Tiers, badges, transitions
   ├─ coalition/   CoalitionAdapter + ApprecioAdapter
   ├─ notifications/  Email, webhook, in-app
   ├─ ai/skill/    Cowork skill: loyaltyos-assistant
   └─ ai/companion/ OpenRouter client + AICompanion.tsx`;
---

<section class="section" id="architecture">
  <div class="arch__inner">
    <EyebrowLabel>Under the Hood</EyebrowLabel>
    <h2 class="section-title arch__h2">
      Built on the stack your engineers already trust.
    </h2>
    <div class="arch__body">
      <p class="section-body">
        LoyaltyOS is a Turborepo monorepo with four apps and ten
        independently-importable packages. TypeScript strict everywhere.
        OpenTelemetry traces, loyaltyos_* Prometheus metrics, and an hourly
        active-members job ships out of the box. The MCP server and AI packages
        live alongside the core — the same conventions, same tooling, same
        release pipeline.
      </p>
    </div>

    <ul class="arch__chips" aria-label="Technology stack">
      {stackChips.map((chip) => <li class="arch__chip-item"><Chip>{chip}</Chip></li>)}
    </ul>

    <div class="arch__tree-block">
      <div class="arch__tree-header">
        <span class="arch__tree-label">loyaltyos/</span>
      </div>
      <pre class="arch__tree-pre" tabindex="0"><code>{monorepoTree}</code></pre>
    </div>
  </div>
</section>

<style>
  .arch__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .arch__h2 {
    margin-top: var(--space-4);
    max-width: 792px;
  }

  .arch__body {
    max-width: 588px;
    margin-top: var(--space-6);
  }

  .arch__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    max-width: var(--max-width);
  }

  .arch__chip-item {
    list-style: none;
  }

  .arch__tree-block {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    width: 100%;
    max-width: 588px;
    margin-top: var(--space-10);
  }

  .arch__tree-header {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .arch__tree-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .arch__tree-pre {
    padding: 20px 24px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--code-text);
    white-space: pre;
  }
</style>
