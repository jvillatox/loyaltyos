---
import EyebrowLabel from "../ui/EyebrowLabel.astro";

const tabs = [
  {
    id: "docker",
    label: "Docker Compose",
    shortLabel: "Docker",
    lang: "bash",
    description: "Run the full stack locally or on any VM.",
    code: `git clone https://github.com/jvillatox/loyaltyos
cd loyaltyos
docker compose up -d`,
  },
  {
    id: "helm",
    label: "Helm",
    shortLabel: "Helm",
    lang: "bash",
    description: "Deploy to any Kubernetes cluster.",
    code: `helm repo add loyaltyos https://jvillatox.github.io/loyaltyos
helm install loyaltyos loyaltyos/loyaltyos \\
  --set postgres.password=$DB_PW`,
  },
  {
    id: "api",
    label: "Issue your first points",
    shortLabel: "API",
    lang: "bash",
    description: "Once it's up, hit the API.",
    code: `curl -X POST http://localhost:4000/v1/points/accrue \\
  -H "Authorization: Bearer $TOKEN" \\
  -H "Idempotency-Key: $(uuidgen)" \\
  -d '{"customerId":"c_123","amount":150,"reason":"purchase"}'`,
  },
  {
    id: "mcp",
    label: "Connect Claude (MCP)",
    shortLabel: "MCP",
    lang: "json",
    description: "Add LoyaltyOS to your agent's MCP config.",
    code: `// ~/.config/claude-code/mcp.json
{
  "mcpServers": {
    "loyaltyos": {
      "command": "npx",
      "args": ["-y", "@loyaltyos/mcp-server"],
      "env": {
        "LOYALTYOS_API_URL": "http://localhost:4000",
        "LOYALTYOS_API_KEY": "sk_live_..."
      }
    }
  }
}`,
  },
];
---

<section class="section" id="quick-start">
  <div class="qs__inner">
    <EyebrowLabel>Quick Start</EyebrowLabel>
    <h2 class="section-title qs__h2">Three commands. Full stack running.</h2>

    <div class="qs__tab-bar" role="tablist" aria-label="Quick start options">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${tab.id}`}
            class={`qs__tab${i === 0 ? " qs__tab--active" : ""}`}
            data-panel={tab.id}
            tabindex={i === 0 ? "0" : "-1"}
          >
            <span class="qs__tab-label-full">{tab.label}</span>
            <span class="qs__tab-label-short" aria-hidden="true">{tab.shortLabel}</span>
          </button>
        ))
      }
    </div>

    {
      tabs.map((tab, i) => (
        <div
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          class={`qs__panel${i === 0 ? "" : " qs__panel--hidden"}`}
          data-panel={tab.id}
        >
          <p class="qs__tab-desc">{tab.description}</p>
          <div class="qs__code-area">
            <div class="qs__code-header">
              <div class="qs__code-dots" aria-hidden="true">
                <span class="qs__dot qs__dot--red"></span>
                <span class="qs__dot qs__dot--yellow"></span>
                <span class="qs__dot qs__dot--green"></span>
              </div>
              <span class="qs__code-lang">{tab.lang}</span>
              <button
                type="button"
                class="qs__copy-btn"
                data-code={tab.code}
                aria-label="Copy code to clipboard"
              >
                Copy
              </button>
            </div>
            <pre class="qs__code-pre" tabindex="0"><code>{tab.code}</code></pre>
          </div>
        </div>
      ))
    }

    <a href="https://docs.loyalty-os.com" class="qs__footer-link">
      Read the full quick-start guide →
    </a>
  </div>
</section>

<style>
  .qs__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .qs__h2 {
    margin-top: var(--space-4);
    max-width: 792px;
  }

  .qs__tab-bar {
    display: flex;
    gap: 0;
    height: 44px;
    width: 100%;
    max-width: var(--max-width);
    margin-top: var(--space-10);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .qs__tab-bar::-webkit-scrollbar {
    display: none;
  }

  .qs__tab {
    flex-shrink: 0;
    padding: 0 var(--space-8);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: color 150ms ease, background-color 150ms ease,
      border-color 150ms ease;
    white-space: nowrap;
  }
  .qs__tab:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }
  .qs__tab--active {
    color: var(--text-primary);
    border-bottom-color: var(--accent);
    background: var(--bg-elevated-2);
  }
  .qs__tab-label-short {
    display: none;
  }
  @media (max-width: 767px) {
    .qs__tab-label-full {
      display: none;
    }
    .qs__tab-label-short {
      display: inline;
    }
  }

  .qs__panel {
    width: 100%;
    max-width: var(--max-width);
    margin-top: var(--space-6);
  }
  .qs__panel--hidden {
    display: none;
  }

  .qs__tab-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .qs__code-area {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .qs__code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    padding: 0 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .qs__code-dots {
    display: flex;
    gap: 6px;
  }
  .qs__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .qs__dot--red {
    background: #ef4444;
  }
  .qs__dot--yellow {
    background: #f59e0b;
  }
  .qs__dot--green {
    background: #10b981;
  }

  .qs__code-lang {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-left: auto;
    margin-right: var(--space-4);
  }

  .qs__copy-btn {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--text-muted);
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    position: relative;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .qs__copy-btn::after {
    content: "";
    position: absolute;
    inset: -11px -8px;
  }
  .qs__copy-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .qs__copy-btn.copied {
    color: var(--success);
    border-color: var(--success);
  }

  .qs__code-pre {
    padding: 20px 24px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--code-text);
    white-space: pre;
  }

  .qs__footer-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-text);
    text-decoration: none;
    margin-top: var(--space-6);
    transition: color 150ms ease;
  }
  .qs__footer-link:hover {
    color: var(--accent-hover);
  }
</style>

<script>
  function setupTabs() {
    const tablist = document.querySelector('[role="tablist"]');
    if (!tablist) return;

    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));

    function activateTab(tabEl) {
      tabs.forEach((t) => {
        t.setAttribute("aria-selected", "false");
        t.classList.remove("qs__tab--active");
        t.setAttribute("tabindex", "-1");
      });
      tabEl.setAttribute("aria-selected", "true");
      tabEl.classList.add("qs__tab--active");
      tabEl.setAttribute("tabindex", "0");
      tabEl.focus();

      const panelId = tabEl.getAttribute("data-panel");
      panels.forEach((p) => {
        if (p.getAttribute("data-panel") === panelId) {
          p.classList.remove("qs__panel--hidden");
        } else {
          p.classList.add("qs__panel--hidden");
        }
      });
    }

    tablist.addEventListener("click", (e) => {
      const tab = (e.target as HTMLElement).closest('[role="tab"]');
      if (tab) activateTab(tab as HTMLElement);
    });

    tablist.addEventListener("keydown", (e) => {
      const current = document.activeElement as HTMLElement;
      const idx = tabs.indexOf(current);
      if (idx === -1) return;

      let next: HTMLElement | null = null;
      if (e.key === "ArrowRight") {
        next = tabs[(idx + 1) % tabs.length];
      } else if (e.key === "ArrowLeft") {
        next = tabs[(idx - 1 + tabs.length) % tabs.length];
      }
      if (next) {
        e.preventDefault();
        activateTab(next);
      }
    });
  }

  function setupCopy() {
    document.querySelectorAll(".qs__copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const code = btn.getAttribute("data-code") || "";
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = "Copied ✓";
          btn.setAttribute("aria-label", "Copied to clipboard");
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.setAttribute("aria-label", "Copy code to clipboard");
            btn.classList.remove("copied");
          }, 1500);
        } catch {
          // noop
        }
      });
    });
  }

  setupTabs();
  setupCopy();
  document.addEventListener("astro:after-swap", () => {
    setupTabs();
    setupCopy();
  });
</script>
