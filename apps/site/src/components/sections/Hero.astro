---
import Button from "../ui/Button.astro";
import CodeBlock from "../ui/CodeBlock.astro";
import { Star } from "lucide-static";

const heroCode = `git clone https://github.com/jvillatox/loyaltyos
cd loyaltyos
docker compose up -d
# → Admin UI on :3000, API on :4000, Portal on :3001`;
---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__h1">
      The open-source loyalty platform with coalition and AI built in.
    </h1>
    <p class="hero__subhead">
      Self-host the points engine, campaigns, coupons, badges, and rewards
      catalog. Plug into Puntos Apprecio out of the box. Run it from any AI
      agent over MCP. MIT licensed. Production-ready since v1.0.0.
    </p>
    <div class="hero__ctas">
      <Button
        variant="primary"
        href="https://github.com/jvillatox/loyaltyos"
        isExternal
      >
        <span class="hero__star-icon" set:html={Star} />
        Star on GitHub
      </Button>
      <Button variant="secondary" href="#quick-start">
        Copy quick start →
      </Button>
    </div>
    <div class="hero__terminal">
      <CodeBlock code={heroCode} language="bash" variant="hero" />
      <p class="hero__caption">
        Runs the full stack — API, admin, customer portal, Postgres, Redis — in
        one command.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(
        ellipse 80% 600px at 50% -80px,
        var(--accent-glow),
        transparent
      ),
      var(--bg-base);
    padding-top: 80px;
    padding-bottom: var(--space-20);
    padding-inline: var(--space-5);
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: 100px;
      padding-bottom: var(--space-30);
      padding-inline: var(--space-6);
    }
  }
  @media (min-width: 1280px) {
    .hero {
      padding-top: 120px;
      padding-bottom: var(--space-40);
      padding-inline: var(--space-10);
    }
  }

  .hero__content {
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__h1 {
    font-size: clamp(3rem, 5vw + 1rem, 4.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
    max-width: 792px;
  }

  .hero__subhead {
    font-size: clamp(1.125rem, 1vw + 0.9rem, 1.25rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    margin: 24px 0 0;
    max-width: 588px;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-10);
    justify-content: center;
  }
  @media (max-width: 767px) {
    .hero__ctas {
      flex-direction: column;
      width: 100%;
      gap: var(--space-3);
    }
    .hero__ctas :global(a),
    .hero__ctas :global(button) {
      width: 100%;
      justify-content: center;
    }
  }

  .hero__terminal {
    width: 100%;
    max-width: 588px;
    margin-top: var(--space-12);
  }
  @media (max-width: 767px) {
    .hero__terminal {
      max-width: 100%;
    }
  }

  .hero__caption {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: var(--space-4) 0 0;
    text-align: center;
  }

  .hero__star-icon {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
  }
  .hero__star-icon :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
