---
import Button from "../ui/Button.astro";
import { Star } from "lucide-static";
---

<nav class="nav" id="nav" aria-label="Main">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="LoyaltyOS home">
      <span class="nav__logo-text">Loyalty<span class="nav__logo-accent">os</span></span>
    </a>
    <div class="nav__links">
      <a href="#features" class="nav__link">Features</a>
      <a href="#coalition" class="nav__link">Coalition</a>
      <a href="#ai" class="nav__link">AI</a>
      <a href="#quick-start" class="nav__link">Quick start</a>
      <a href="https://docs.loyalty-os.com" class="nav__link">Docs</a>
      <a
        href="https://github.com/jvillatox/loyaltyos"
        class="nav__link"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
    <div class="nav__cta">
      <Button
        variant="primary"
        href="https://github.com/jvillatox/loyaltyos"
        isExternal
      >
        <span class="nav__star-icon" set:html={Star} />
        Star on GitHub
      </Button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    height: var(--nav-height);
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms ease, backdrop-filter 200ms ease,
      border-color 200ms ease;
  }
  .nav--scrolled {
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }

  .nav__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-5);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 768px) {
    .nav__inner {
      padding-inline: var(--space-6);
    }
  }
  @media (min-width: 1280px) {
    .nav__inner {
      padding-inline: var(--space-10);
    }
  }

  .nav__logo {
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav__logo-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .nav__logo-accent {
    color: var(--accent-text);
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .nav__link:hover {
    color: var(--text-primary);
  }

  .nav__cta {
    display: flex;
    align-items: center;
  }
  @media (max-width: 767px) {
    .nav__cta :global(.btn-text) {
      display: none;
    }
  }

  .nav__star-icon {
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
  }
  .nav__star-icon :global(svg) {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
</style>

<script>
  const nav = document.getElementById("nav");
  function onScroll() {
    nav?.classList.toggle("nav--scrolled", window.scrollY > 0);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
