---
import Base from "../layouts/Base.astro";
import Nav from "../components/sections/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import ProblemFraming from "../components/sections/ProblemFraming.astro";
import FeaturesGrid from "../components/sections/FeaturesGrid.astro";
import CoalitionSpotlight from "../components/sections/CoalitionSpotlight.astro";
import AILayerSpotlight from "../components/sections/AILayerSpotlight.astro";
import QuickStart from "../components/sections/QuickStart.astro";
import ArchStack from "../components/sections/ArchStack.astro";
import OSSPositioning from "../components/sections/OSSPositioning.astro";
import Community from "../components/sections/Community.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/sections/Footer.astro";
---

<Base>
  <Nav />
  <main id="main-content">
    <Hero />
    <TrustBar />
    <ProblemFraming />
    <FeaturesGrid />
    <CoalitionSpotlight />
    <AILayerSpotlight />
    <QuickStart />
    <ArchStack />
    <OSSPositioning />
    <Community />
    <FAQ />
  </main>
  <Footer />
</Base>
