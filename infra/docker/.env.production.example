# LoyaltyOS — Production Environment Variables
# Copy this file to .env.production and fill in your values:
#   cp infra/docker/.env.production.example infra/docker/.env.production
#
# Then start the production stack:
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file infra/docker/.env.production up -d

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=loyaltyos
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=loyaltyos

# ── Tenancy (PostgreSQL row-level security, optional) ────
# Leave this whole section unset to keep the current single-role setup. To split
# the runtime into a least-privileged role, set LOYALTYOS_APP_DB_PASSWORD and
# point DATABASE_URL at the `loyaltyos_app` role; MIGRATION_DATABASE_URL keeps
# the owner (POSTGRES_USER) for migrations and provisioning.
# Provisioning issues CREATE ROLE, so the owner needs CREATEROLE. A plain DB
# owner has it; on managed Postgres (RDS, Cloud SQL, Azure) a DBA may need to run
# the SQL in docs/design/tenancy.md §2.3 by hand instead.
# DATABASE_URL=postgresql://loyaltyos_app:change-me@postgres:5432/loyaltyos
# MIGRATION_DATABASE_URL=postgresql://loyaltyos:change-me@postgres:5432/loyaltyos
# LOYALTYOS_APP_DB_PASSWORD=change-me
# TENANCY_RLS=off                 # off | audit | enforce

# ── Server ───────────────────────────────────────────────
PORT_API=3002
PORT_ADMIN=5173
PORT_PORTAL=5174
NODE_ENV=production
# Comma-separated origins allowed to call the API (admin, portal, and every
# merchant site that embeds the widget). The wildcard "*" is NOT supported.
CORS_ORIGINS=https://admin.your-domain.com,https://portal.your-domain.com,https://shop.your-domain.com
LOG_LEVEL=info

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-64-char-random
API_KEY_SALT=change-me-in-production-use-32-char-random

# ── Credential Encryption ────────────────────────────────
# 32-byte hex string for AES-256-GCM. Generate with: openssl rand -hex 32
KMS_MASTER_KEY=change-me-in-production

# ── Gift Cards ───────────────────────────────────────────
# HMAC secret for gift-card codes. Required in production — the API refuses
# to boot if empty or set to "dev-secret". Generate with: openssl rand -hex 32
GIFTCARD_HMAC_SECRET=

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ── SMS (Twilio) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_API_BASE=   # Override for testing — leave empty for production

# ── Push (OneSignal) ─────────────────────────────────────
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key
# ONESIGNAL_API_BASE= # Override for testing — leave empty for production

# ── Coalition — Apprecio ─────────────────────────────────
# Country URLs:
#   MX: https://apiv2.dcanje.mx/api
#   CL: https://api.apprecio.cl/api
#   CO: https://apiv2.apprecio.com.co/api
#   PE: https://apiv2.apprecio.pe/api
#   EC: https://apiv2.ec.dcanje.com/api
APPRECIO_API_BASE=https://apiv2.dcanje.mx/api
APPRECIO_PUBLIC_TOKEN=your_apprecio_public_token
APPRECIO_PRIVATE_TOKEN=your_apprecio_private_token
APPRECIO_IDENTIFIER_TYPE=email
APPRECIO_TIMEOUT_MS=10000

# ── Observability ──────────────────────────────────────────
# OpenTelemetry — set the OTLP endpoint to enable distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_SERVICE_NAME=loyaltyos-api
# WORKER_METRICS_PORT=3003   # Port for the standalone worker metrics/health server

# Bearer token required to scrape /metrics in production. If left empty,
# /metrics is hidden (404) in production and open in development.
# Prometheus (or any scraper) must send: Authorization: Bearer <METRICS_TOKEN>
# Generate with: openssl rand -hex 32
# METRICS_TOKEN=
